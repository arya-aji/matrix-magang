DATABASE_URL=postgresql://user:password@localhost:5432/intern_matrix

AUTH_SECRET=replace-with-secure-secret

NEXT_PUBLIC_APP_URL=http://localhost:3000

APP_TIMEZONE=Asia/Jakarta

# ---------------------------------------------------------------------------
# Bootstrap seed (`npm run db:seed`).
# The seed is idempotent and never deletes domain data, so it is safe to run on
# every deployment. Existing passwords are never overwritten.
# ---------------------------------------------------------------------------

# Run the bootstrap seed automatically when the container starts.
# Recommended: true for the first deployment, then set it back to false.
RUN_SEED_ON_START=false

# Admin account. CHANGE THE PASSWORD BEFORE DEPLOYING.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_NAME=Administrator
SEED_ADMIN_PASSWORD=Password123!

# Mentor account that owns the intern roster.
SEED_MENTOR_EMAIL=mentor@bpsjakpus.cloud
SEED_MENTOR_NAME=Mentor BPS Jakpus
SEED_MENTOR_PASSWORD=Password123!

# Password assigned to newly created intern accounts.
SEED_INTERN_PASSWORD=Password123!

# Internship window applied to interns that do not have one yet.
# SEED_INTERNSHIP_START=2026-09-28
SEED_INTERNSHIP_DAYS=90
